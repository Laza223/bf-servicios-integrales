---
interface Props {
  heading?: string;
}
const { heading = 'Así trabajamos' } = Astro.props;

const steps = [
  { title: 'Nos escribís', text: 'Por WhatsApp o por teléfono. Contanos qué necesitás y, si podés, mandá fotos: ganamos tiempo.' },
  { title: 'Visita sin cargo', text: 'Vamos a ver el lugar, medimos y te explicamos qué conviene hacer y por qué.' },
  { title: 'Presupuesto por escrito', text: 'Detallado, con materiales y mano de obra, para que sepas qué se hace antes de empezar.' },
  { title: 'Instalación y prueba', text: 'Trabajo prolijo, probado delante tuyo, con la configuración de apps y equipos incluida.' },
];
---

<section class="section process" aria-labelledby="proceso-titulo">
  <div class="wrap">
    <h2 id="proceso-titulo" data-reveal>{heading}</h2>
    <ol class="steps" data-process>
      {steps.map((s, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--surface); }
  .steps { list-style: none; margin: 2.75rem 0 0; padding: 0; display: grid; gap: 2rem; counter-reset: s; }
  .steps li { position: relative; padding-left: 4.25rem; }
  .num { position: absolute; left: 0; top: -0.2rem; width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; font-stretch: 115%; font-size: 1.25rem; }
  .steps h3 { margin-bottom: 0.4rem; }
  .steps p { color: var(--muted); max-width: 34ch; }
  @media (min-width: 60rem) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .steps li { padding-left: 0; padding-top: 4.5rem; }
    .steps li::before { content: ''; position: absolute; top: 1.3rem; left: 3.5rem; right: -1rem; height: 2px; background: repeating-linear-gradient(90deg, var(--brand-700) 0 8px, transparent 8px 14px); clip-path: inset(0 calc(100% * (1 - var(--p, 1))) 0 0); }
    .steps li:last-child::before { display: none; }
  }
</style>
