---
import Icon from './Icon.astro';
import { waLink, telLink, business } from '../data/business';

interface Props {
  heading: string;
  text: string;
  waMessage: string;
  ctaLabel?: string;
}
const { heading, text, waMessage, ctaLabel = 'Pedir visita sin cargo' } = Astro.props;
---

<section class="final" aria-labelledby="cierre-titulo">
  <div class="wrap inner" data-stagger>
    <div>
      <h2 id="cierre-titulo">{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn" data-pulse href={waLink(waMessage)} target="_blank" rel="noopener" data-cta="whatsapp-final">
        <Icon name="whatsapp" size={22} /> {ctaLabel}
      </a>
      <a class="btn btn--ghost" href={telLink} data-cta="tel-final">
        <Icon name="Phone" size={20} /> Llamar · {business.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .final { background: var(--brand); color: var(--on-brand-muted); padding-block: clamp(3.5rem, 7vw, 5.5rem); position: relative; overflow: hidden; }
  .final::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60rem 30rem at 100% 0%, rgb(249 115 22 / 0.16), transparent 60%); pointer-events: none; }
  .inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  h2 { color: #fff; max-width: 18ch; }
  p { margin-top: 1rem; font-size: 1.15rem; max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (min-width: 60rem) {
    .inner { grid-template-columns: 1.3fr 1fr; }
    .actions { justify-content: flex-end; }
  }
</style>
