---
import Icon from './Icon.astro';

// Tira de credenciales verificables. Nada de acá se puede inventar: ver PRODUCT.md.
const items = [
  { icon: 'GraduationCap', title: 'Electricista Industrial', text: 'Título de Centro de Formación Profesional' },
  { icon: 'Clock', title: 'Urgencias 24 h', text: 'Todos los días, también feriados' },
  { icon: 'FileText', title: 'Factura C', text: 'Para casas, comercios y empresas' },
  { icon: 'ShieldCheck', title: 'Seguro para planta', text: 'AP con cláusula de no repetición' },
];

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<ul class:list={['creds', tone]}>
  {items.map((i) => (
    <li>
      <Icon name={i.icon} size={26} />
      <span><strong>{i.title}</strong><span>{i.text}</span></span>
    </li>
  ))}
</ul>

<style>
  .creds { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem 2rem; }
  .creds li { display: flex; gap: 0.85rem; align-items: flex-start; }
  .creds :global(.icon) { flex: none; margin-top: 0.1rem; }
  .dark :global(.icon) { color: #fff; }
  .light :global(.icon) { color: var(--brand); }
  .creds strong { display: block; font-weight: 750; line-height: 1.25; }
  .creds li > span > span { display: block; font-size: 0.93rem; line-height: 1.4; }
  .dark strong { color: #fff; }
  .dark li > span > span { color: var(--on-brand-muted); }
  .light strong { color: var(--brand); }
  .light li > span > span { color: var(--muted); }
</style>
