---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'servicios'>[];
}
const { items } = Astro.props;
---

<ul class="rows" data-stagger>
  {items.map((s) => (
    <li>
      <a href={`/${s.id}/`}>
        <Icon name={s.data.icon} size={30} />
        <span class="txt">
          <span class="name">{s.data.name}</span>
          <span class="sum">{s.data.summary}</span>
        </span>
        <Icon name="ArrowRight" size={22} class="go" />
      </a>
    </li>
  ))}
</ul>

<style>
  .rows { border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { display: grid; grid-template-columns: auto 1fr auto; gap: 1.1rem; align-items: center; padding: 1.35rem 0.25rem; color: var(--text); text-decoration: none; transition: background-color 0.25s var(--ease); }
  a > :global(.icon:first-child) { color: var(--brand); box-sizing: content-box; padding: 0.55rem; border-radius: var(--radius); background: rgb(20 45 78 / 0.07); }
  .txt { display: grid; gap: 0.2rem; }
  .name { font-weight: 800; font-stretch: 108%; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--brand); }
  .sum { color: var(--muted); }
  a :global(.go) { color: var(--brand-700); transition: transform 0.3s var(--ease); }
  a:hover { background: rgb(20 45 78 / 0.035); }
  a:hover :global(.go) { transform: translateX(4px); }
</style>
