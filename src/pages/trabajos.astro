---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FinalCta from '../components/FinalCta.astro';
import { business } from '../data/business';
import { trabajos, real } from '../data/trabajos';

const servicios = await getCollection('servicios');
const nameOf = (id: string) => servicios.find((s) => s.id === id)?.data.name ?? '';
const waMessage = 'Hola BF, vi sus trabajos en la web y quiero pedir presupuesto.';
---

<Base
  title="Trabajos realizados en Luján y zona | BF Servicios Integrales"
  description="Tableros, cámaras, alarmas, porteros y portones instalados por BF Servicios Integrales en Luján, Provincia de Buenos Aires, y alrededores."
  waMessage={waMessage}
  noindex={!real}
>
  <section class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Trabajos</span></nav>
      <h1>Trabajos realizados</h1>
      <p class="lede">Instalaciones eléctricas, industriales y de seguridad en Luján y la zona.</p>
      {business.instagram && <a class="ig" href={business.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={20} /> Ver más en Instagram</a>}
    </div>
  </section>

  <section class="section gallery-wrap" aria-label="Galería">
    <div class="wrap">
      <ul class="gallery" data-stagger>
        {trabajos.map((t) => (
          <li>
            <figure>
              <Image src={t.image} alt={t.alt} widths={[400, 640, 900]} sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw" style={t.position ? `object-position: ${t.position}` : undefined} />
              <figcaption>
                <strong>{t.title}</strong>
                <span>{t.place && `${t.place} · `}<a href={`/${t.service}/`}>{nameOf(t.service)}</a></span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta
    heading="¿Querés un trabajo así?"
    text="Mandanos una foto de lo que necesitás por WhatsApp y coordinamos la visita sin cargo."
    waMessage={waMessage}
  />
</Base>

<style>
  .head { background: var(--brand); color: var(--on-brand-muted); padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .crumbs { font-size: 0.93rem; margin-bottom: 1.25rem; display: flex; gap: 0.5rem; }
  .crumbs a { color: #fff; }
  .head h1 { color: #fff; }
  .head .lede { color: #dbe3ec; margin-top: 1rem; }
  .ig { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem; color: #fff; font-weight: 700; }
  .ig:hover { color: var(--accent); }
  .gallery { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  figure { margin: 0; background: var(--surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption { padding: 1rem 1.15rem 1.2rem; display: grid; gap: 0.2rem; }
  figcaption strong { color: var(--brand); font-weight: 750; }
  figcaption span { color: var(--muted); font-size: 0.95rem; }
</style>
