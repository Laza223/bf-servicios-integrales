---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Credentials from '../components/Credentials.astro';
import ServiceRows from '../components/ServiceRows.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { business, coverage, waLink, telLink } from '../data/business';
import { real as trabajosReales } from '../data/trabajos';
import heroImg from '../assets/placeholder/tablero.jpg';
import plantImg from '../assets/placeholder/distribucion.jpg';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const industria = servicios.find((s) => s.id === 'electricidad-industrial')!;
const seguridad = servicios.filter((s) => s.data.group === 'seguridad');
const hogar = servicios.filter((s) => s.data.group === 'hogar');

const waMessage = 'Hola BF, vi la web y quiero pedir una visita sin cargo. Les cuento:';

const faqs = [
  { q: '¿En qué zonas trabajan?', a: `Tenemos base en Luján, Provincia de Buenos Aires, y trabajamos en todo el partido (${coverage.partido.slice(1).join(', ')}) y en ${coverage.zona.join(', ')}. Para obras en otras provincias coordinamos viáticos.` },
  { q: '¿La visita y el presupuesto tienen costo?', a: 'No. Vamos, miramos el lugar y te pasamos el presupuesto por escrito sin cargo y sin compromiso.' },
  { q: '¿Atienden urgencias de noche o los fines de semana?', a: 'Sí, las urgencias eléctricas se atienden las 24 horas, todos los días, también feriados.' },
  { q: '¿Hacen factura?', a: 'Sí, emitimos factura C, tanto a particulares como a comercios, consorcios y empresas.' },
  { q: '¿Cómo se puede pagar?', a: `${business.payments.join(', ')}.` },
  { q: '¿Qué marcas instalan?', a: `Trabajamos con ${business.brands.join(', ')} y también con la marca que prefieras. Los equipos tienen garantía oficial.` },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Electricista en Luján, Bs. As. | Industria y seguridad · BF"
  description="Electricista industrial y seguridad electrónica en Luján, Bs. As.: tableros, motores, cámaras, alarmas y porteros. Urgencias 24 h y presupuesto sin cargo."
  waMessage={waMessage}
  ogImage={heroImg}
  jsonLd={[faqLd]}
>
  <section class="hero">
    <Image src={heroImg} alt="" class="hero-bg" data-parallax="3" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="wrap hero-inner">
      <p class="hero-place" data-hero style="--d: 0"><Icon name="MapPin" size={18} /> Luján, Provincia de Buenos Aires</p>
      <h1 data-hero style="--d: 80">Electricista industrial y seguridad electrónica en Luján</h1>
      <p class="hero-lede" data-hero style="--d: 200">Tableros, motores y mantenimiento para industrias. Cámaras, alarmas y porteros para casas y comercios. Visita y presupuesto sin cargo, urgencias las 24 horas.</p>
      <div class="hero-actions" data-hero style="--d: 320">
        <a class="btn" data-pulse href={waLink(waMessage)} target="_blank" rel="noopener" data-cta="whatsapp-hero">
          <Icon name="whatsapp" size={22} /> Pedir visita sin cargo
        </a>
        <a class="btn btn--ghost hero-tel" href={telLink} data-cta="tel-hero">
          <Icon name="Phone" size={20} /> Llamar · urgencias 24 h
        </a>
      </div>
      <div class="hero-creds" data-hero style="--d: 460">
        <Credentials />
      </div>
    </div>
  </section>

  <section class="section industria" aria-labelledby="industria-titulo">
    <div class="wrap ind-grid">
      <div class="ind-media" data-mask>
        <Image src={plantImg} alt="Tablero general de distribución eléctrica en una planta" data-parallax="5" widths={[480, 720, 960]} sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>
      <div class="ind-copy" data-reveal>
        <h2 id="industria-titulo">Listo para entrar a tu planta</h2>
        <p class="lede">Electricista industrial con título de Centro de Formación Profesional y más de 5 años de experiencia. Llegamos con factura y seguro con cláusula de no repetición, que es lo que te pide seguridad e higiene para dejarnos pasar.</p>
        <ul class="ind-list" data-stagger>
          {industria.data.items.slice(0, 5).map((i) => (
            <li><Icon name="Check" size={20} /> {i.title}</li>
          ))}
        </ul>
        <p class="ind-abono"><strong>Mantenimiento con abono</strong> para industrias y consorcios: preventivo programado y prioridad en urgencias. Consultá planes.</p>
        <div class="ind-actions">
          <a class="btn btn--navy" href={`/${industria.id}/`}>Ver electricidad industrial <Icon name="ArrowRight" size={20} /></a>
          <a class="text-link" href={waLink(industria.data.waMessage)} target="_blank" rel="noopener" data-cta="whatsapp-industria">
            <Icon name="whatsapp" size={18} /> Pedir visita técnica a planta
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section servicios" aria-labelledby="servicios-titulo">
    <div class="wrap">
      <h2 id="servicios-titulo" data-reveal>Todo lo eléctrico y la seguridad, con un solo técnico</h2>
      <div class="groups">
        <div class="group">
          <h3>Seguridad electrónica</h3>
          <p>Para casas, comercios, campos y edificios.</p>
          <ServiceRows items={seguridad} />
        </div>
        <div class="group">
          <h3>Hogar, comercio y automatismos</h3>
          <p>Desde una térmica que salta hasta un portón que abre solo.</p>
          <ServiceRows items={hogar} />
        </div>
      </div>
    </div>
  </section>

  <Process />

  <section class="section cobertura" aria-labelledby="cobertura-titulo">
    <div class="wrap cob-grid">
      <div data-reveal>
        <h2 id="cobertura-titulo">Dónde trabajamos</h2>
        <p class="lede">Base en Luján, Provincia de Buenos Aires. Trabajamos en todo el partido y en la zona; para obras más lejos, coordinamos viáticos.</p>
      </div>
      <div class="zones" data-stagger>
        <div>
          <h3>Partido de Luján</h3>
          <ul>{coverage.partido.map((z) => <li>{z}</li>)}</ul>
        </div>
        <div>
          <h3>Zona</h3>
          <ul>{coverage.zona.map((z) => <li>{z}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  {trabajosReales && (
  <section class="trabajos-band" aria-labelledby="trabajos-titulo">
    <div class="wrap tb-inner" data-reveal>
      <div>
        <h2 id="trabajos-titulo">Mirá trabajos reales</h2>
        <p>Tableros de control, motores y cámaras instalados por BF.</p>
      </div>
      <div class="tb-actions">
        <a class="btn btn--navy" href="/trabajos/">Ver trabajos <Icon name="ArrowRight" size={20} /></a>
        {business.instagram && <a class="text-link" href={business.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Seguinos en Instagram</a>}
      </div>
    </div>
  </section>
  )}

  <Faq faqs={faqs} />

  <FinalCta
    heading="¿Qué necesitás resolver?"
    text="Escribinos por WhatsApp con una foto o una descripción corta. Te respondemos y coordinamos la visita sin cargo."
    waMessage={waMessage}
  />
</Base>

<style>
  .hero { position: relative; isolation: isolate; background: var(--brand-900); color: var(--on-brand-muted); overflow: hidden; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero :global(.hero-bg) { object-position: 70% 50%; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(11 27 48 / 0.9), rgb(20 45 78 / 0.86)); }
  @media (min-width: 60rem) { .hero::after { background: linear-gradient(180deg, transparent 60%, rgb(11 27 48 / 0.85)), linear-gradient(100deg, rgb(11 27 48 / 0.96) 0%, rgb(20 45 78 / 0.9) 50%, rgb(20 45 78 / 0.5) 100%); } }
  .hero-tel { display: none; }
  @media (min-width: 48rem) { .hero-tel { display: inline-flex; } }
  .hero-inner { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 5vw, 3.5rem); }
  .hero-place { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--on-brand-muted); font-weight: 600; margin-bottom: 1.25rem; }
  .hero-place :global(.icon) { color: var(--on-brand-muted); }
  .hero h1 { color: #fff; max-width: 17ch; }
  .hero-lede { margin-top: 1.5rem; font-size: clamp(1.0625rem, 1rem + 0.45vw, 1.3rem); max-width: 56ch; color: #dbe3ec; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .hero-creds { margin-top: clamp(3rem, 7vw, 5rem); padding-top: 2rem; border-top: 1px solid rgb(255 255 255 / 0.14); }

  .industria { background: var(--surface); }
  .ind-grid { display: grid; gap: 2.5rem; align-items: center; }
  .ind-media { position: relative; overflow: hidden; border-radius: var(--radius); }
  .ind-media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 60rem) and (hover: hover) and (prefers-reduced-motion: no-preference) { .ind-media :global(img) { scale: 1.1; } }
  .ind-media::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); background: linear-gradient(180deg, transparent 50%, rgb(20 45 78 / 0.35)); }
  .ind-copy .lede { margin-top: 1.25rem; }
  .ind-list { margin-top: 1.75rem; display: grid; gap: 0.6rem; }
  .ind-list li { display: flex; gap: 0.7rem; align-items: center; font-weight: 600; }
  .ind-list :global(.icon) { color: var(--brand-700); flex: none; }
  .ind-abono { margin-top: 1.75rem; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--muted); }
  .ind-abono strong { color: var(--brand); }
  .ind-actions, .tb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--brand); }
  @media (min-width: 60rem) { .ind-grid { grid-template-columns: 1fr 1.05fr; gap: 4.5rem; } }

  .servicios h2 { max-width: 28ch; }
  .groups { display: grid; gap: 3rem; margin-top: 3rem; }
  .group > h3 { margin-bottom: 0.35rem; }
  .group > p { color: var(--muted); margin-bottom: 1.25rem; }
  @media (min-width: 60rem) { .groups { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .cob-grid { display: grid; gap: 2.5rem; }
  .cobertura .lede { margin-top: 1.25rem; }
  .zones { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .zones h3 { font-size: 1.1rem; margin-bottom: 1rem; }
  .zones ul { display: grid; gap: 0.5rem; color: var(--muted); }
  .zones ul li:first-child { color: var(--brand); font-weight: 750; }
  @media (min-width: 60rem) { .cob-grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .trabajos-band { background: var(--surface); border-block: 1px solid var(--line); padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .tb-inner { display: grid; gap: 1rem; align-items: center; }
  .tb-inner h2 { font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.25rem); }
  .tb-inner p { margin-top: 0.5rem; color: var(--muted); }
  .tb-actions { margin-top: 0.5rem; }
  @media (min-width: 60rem) { .tb-inner { grid-template-columns: 1fr auto; } .tb-actions { margin-top: 0; } }
</style>
